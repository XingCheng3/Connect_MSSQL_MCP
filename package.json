{
  "name": "connect-mssql-mcp",
  "version": "1.1.0",
  "description": "MCP server for executing MSSQL queries with dynamic per-request connection args",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "connect-mssql-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "npm run build",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mssql",
    "sqlserver",
    "typescript",
    "database",
    "llm"
  ],
  "author": "XingCheng3",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XingCheng3/Connect_MSSQL_MCP.git"
  },
  "bugs": {
    "url": "https://github.com/XingCheng3/Connect_MSSQL_MCP/issues"
  },
  "homepage": "https://github.com/XingCheng3/Connect_MSSQL_MCP#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "mssql": "^10.0.2"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^20.11.20",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
